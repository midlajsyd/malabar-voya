    function getSoldOutDateArrayByHotel(_hotelcode) {
        var retSoldOutDates = [];

        if (typeof arrCalendarSoldOutDates != "undefined" && typeof _hotelcode != "undefined") {
            for (var i = 0; i < arrCalendarSoldOutDates.length; i++) {
                if (arrCalendarSoldOutDates[i].hotelcode.toLowerCase() == _hotelcode.toLowerCase()) {
                    retSoldOutDates = arrCalendarSoldOutDates[i].soldout_dates.slice(0);
                    break;
                }
            }
        }

        return retSoldOutDates;
    }

    function getMarketingAssetsMessageByHotel(_hotelcode) {
        var arrData = [];

        if (typeof arrCalendarMarketingAssetsMessage != "undefined" && typeof _hotelcode != "undefined") {
            for (var i = 0; i < arrCalendarMarketingAssetsMessage.length; i++) {
                if (arrCalendarMarketingAssetsMessage[i].hotelcode.toLowerCase() == _hotelcode.toLowerCase()
                    && arrCalendarMarketingAssetsMessage[i].display_message != ""
                ) {
                    arrData.push(arrCalendarMarketingAssetsMessage[i]);
                    break;
                }
            }
        }

        return arrData;
    }
