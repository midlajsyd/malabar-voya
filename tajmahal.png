        if (readCookie("oOneUserId") != "") {
            arrCalendarSoldOutDates = arrCalendarSoldOutDatesLoggedIn;
        }
        else {
            arrCalendarSoldOutDates = arrCalendarSoldOutDatesNotLoggedIn;
        }
    }
