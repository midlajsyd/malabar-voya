<style>
	
.global-wellness-day-wrapper {
    
    margin-top: 20px;
  
}	
	.heading-component p span{
    font-family: "Roboto",sans-serif;
    font-size: 18px;
		
   
}

	
.global-wellness-day-wrapper .image-text-component-style1 {
    margin-bottom: 30px;
    display: flex;
    align-items: center;
}
.experiences-page.best-of-egypt-wrapper .heading-component > p{
 max-width:100% !important;
}
    .global-wellness-day-wrapper .image-text-component-style1 .img-colm {
    float: left;
    width: 45%;
    padding-right: 15px;
}
.global-wellness-day-wrapper .image-text-component-style1 .text-colm {
    width: 55%;
    padding: 20px 20px 15px;
}
.global-wellness-day-wrapper .image-text-component-style1.right-bx {
    flex-direction: row-reverse;
}
.global-wellness-day-wrapper .image-text-component-style1.right-bx .img-colm {
    padding: 0 0 0 14px;
}
.wfh-common-page .three-image-gallery p {
    font-size: 15px;
    font-family: "Roboto",sans-serif;
    margin-bottom: 0;
    width: 100%;
    float: left;
    margin: 10px 0;
}
.section-expand-bx {
    height: 35px;
    background: url(/images/OberoiHotels/common/gradient.png) repeat-x top left;
    background-color: #fff;
    display: block;
    text-align: center;
    position: absolute;
    z-index: 1;
    bottom: -10px;
    width: 100%;
    text-align: center;
    display: none;
}
.section-expand-bx .down-arrow-btn{
    display: inline-block;
    border-bottom: 2px solid #d97720;
    border-right: 2px solid #d97720;
    bottom: 10px;
    height: 10px;
    -moz-transform: rotate(45deg) translateX(-50%);
    -webkit-transform: rotate(45deg) translateX(-50%);
    -ms-transform: rotate(45deg) translateX(-50%);
    -o-transform: rotate(45deg) translateX(-50%);
    transform: rotate(45deg) translateX(-50%);
    width: 10px;
    z-index: 2;
    cursor: pointer;
    transition: all 1s ease;
} 
.section-expand-bx .down-arrow-btn.active {
    moz-transform: rotate(224deg);
    -webkit-transform: rotate(224deg);
    -ms-transform: rotate(224deg);
    -o-transform: rotate(224deg);
    transform: rotate(224deg);
}
.text-colm.description-col.div-down-arrow.flhgt{
    max-height: 100% !important;
}

.diwali-hamper-slider{width: 100%; float: left;}
.diwali-hamper-slider .image-text-block-style1{width: 31.33%; float: left; margin-right: 2%; min-height: 250px; margin-bottom: 50px;}
.left-section {
    display: inline-block;
    margin: 5px 0 20px 0;
    vertical-align: bottom;
    width: 100%;
}
.left-section h3{
    font-family: "EB Garamond", serif;
    font-weight: 300;
    font-size: 24px;
    margin-bottom: 10px;
}
.diwali-hamper-slider .image-text-block-style1 .image-block{
    width: 100%; float: left;
}
.diwali-hamper-slider .image-text-block-style1 .image-block img{width: 100%;}
.diwali-hamper-slider .image-text-block-style1 .text-block{
    width: 100%; float: left;
}
.diwali-hamper-slider .image-text-block-style1 .text-block .offerName{
    font-size: 1.5em;
    font-family: "EB Garamond",serif;
}
.text-container-diwali-banner-text{
position: absolute;
    z-index: 1;
    bottom: 50px;
    font-size: 2em;
    font-family: "EB Garamond",serif;
    color: #fff;
    text-align: center;
    width: 100%;
}
.alliance-partners-section-component .omo-alliance-partner-section h3{
  font-weight:300;
}
    .alliance-partners-section-component .banner-section{
        position: relative;
    }
    
    .alliance-partners-section-component .banner-section .text-container{
        position: absolute;
        bottom: 0;
        color: #fff;
        font-family: "EB Garamond",serif;
        text-shadow: 6px 10px 20px #000;
        right: 15px;
    }
    .alliance-partners-section-component .banner-section .text-container p{
        font-size: 16px !important;
    }
    
    .alliance-partners-section-component .featured-slider .text-block .offerName{cursor: pointer;}
	.hotels-desc {
    	font-size: 1.1em !important;
	}
	.image-and-description-with-legend-attributes-option-3 .description-col.div-down-arrow{
       max-height: 100%;
	}
    
    @media only screen and (max-width: 1024px){
    .alliance-partners-section-component .about-o-one h2, .alliance-partners-section-component .omo-alliance-partner-section h1, .alliance-partners-section-component .omo-alliance-partner-section h2 {
    font-size: 32px;
    }
    }
    @media only screen and (max-width:767px) {
    	.global-wellness-day-wrapper .image-text-component-style1{display: block;}
        .image-and-description-with-legend-attributes-option-3 .description-col.div-down-arrow{
            max-height: 100% !important;
        }
    .diwali-hamper-slider .image-text-block-style1 {
        width: 100%;
        float: left;
        margin-right: 0;
        min-height: auto;
        margin-bottom: 20px;
    }
        .alliance-partners-section-component .banner-section .text-container {
        right: auto;
        width: 100%;
        text-align: center;
        }
        
        .image-text-block-style1 .text-block .btn-style2:after{border-color: #fff !important;}
        
        .bodyWrapMobile .btns-list a.btn-style1:after, .bodyWrapMobile .btns-list a.btn-style2:after, .bodyWrapMobile .image-text-block-style1 .text-block .btn-style1:after, .bodyWrapMobile .image-text-block-style1 .text-block .btn-style2:after{right: 10px; margin-top: -5px;}
        
        .alliance-partners-section-component .omo-alliance-details .desc .btn-style2, .bodyWrapMobile .btn-style2, .alliance-partners-section-component .image-and-description-with-legend-attributes-option-3 .omo-width50Per.omo-space-side .btn-style1, .dashboard .member-offer .offer-book-now-btn a, .dashboard .upcoming-stays .no-value .offer-book-now-btn a, .dashboard .past-stays-dtls-wrap .past-stays-box .past-stays-dtls-box-wrap .no-value .offer-book-now-btn a, .dashboard .contact-us-form-wrap .contact-form-button-wrap .contact-form-btn, .oberoi-one-omo-alliance-offer-content-sec .omo-oberoi-one-book-now-sec a, .contact-us-form .form-button .btn-style1, .contact-us-form .form-button .btn-style2, .dashboard .upcoming-stays .ineligible-box .content-box .addFlightDetails .form .submit, .dashboard .past-stays-dtls-wrap .past-stays-dtls-box .stay-book-btn .submit, .upcoming-stg-btn, .add-upcoming-stays-wrapper .upcoming-stays-slider .stays-details .submit-btn{
            text-transform: uppercase !important;
            padding:12px 24px 12px 20px;
            line-height: 100%;
            background: #d57600;
            box-shadow: 0px 5px 5px #ccc;
            border-radius: 5px;
            color: #fff !important;
            border: 1px solid #d57600;
            position: relative;
            background-image: none;
             
            margin: 10px 0px 30px 0;
            float: left;
            min-width: 90px;
            font-size: 15px !important;
            font-weight: 400;
        }
        a.btn-style2.wht-btn, .dashboard .contact-us-form-wrap .contact-form-button-wrap .contact-form-btn.submit-btn{
            background: #fff;
            border-color: #d57600;
        }
        .global-wellness-day-wrapper .image-text-component-style1 .img-colm,
        .global-wellness-day-wrapper .image-text-component-style1 .text-colm,
        .global-wellness-day-wrapper .image-text-component-style1.right-bx .img-colm{
            width: 100%;
            padding: 0;
        }
        .image-text-component-style1-slider .slick-list{
        	padding: 0;
        }
        .image-text-component-style1-slider .slick-slide{
            width: 100% !important;
        }
    }

</style>
    

    





