                    <img itemprop="image" id="slide1" src="/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/1920x582-taj-mahal.jpg" data-sizes="xl, l, m, s, xs" data-imageset="/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/1920x582-taj-mahal.jpg,/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/1920x582-taj-mahal.jpg,/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/1920x582-taj-mahal.jpg,/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/1920x582-taj-mahal.jpg,/-/media/oberoi-hotels/website-images/oberoi-blog-images/july-blogs-images/414x580-taj-mahal.jpg" alt="" title="">
