    <script type="text/javascript">
        $(document).ready(function () {
            headerScroll();
            //homePageBanner();
            menuAcoor();
            $(".customScroll").mCustomScrollbar();
            $(".t-datepicker-day").mCustomScrollbar();
            function isArray(what) {
                return Object.prototype.toString.call(what) === '[object Array]';
            }
            if (readCookie("OberoiOneLoggedMemberBasicInformation") != "") {
                var basicObjectCookie = JSON.parse(readCookie('OberoiOneLoggedMemberBasicInformation'));

                if (isArray(basicObjectCookie)) {
                    $('.o-one-user-name-short').html(basicObjectCookie[0]["FirstName"][0].toUpperCase() + " " + basicObjectCookie[0]["LastName"][0].toUpperCase())
                }
                else {
                    $('.o-one-user-name-short').html(basicObjectCookie["FirstName"][0].toUpperCase() + " " + basicObjectCookie["LastName"][0].toUpperCase())
                }
            }
        });
    </script>
    <script src="/Scripts/OberoiHotels/plugin/recliner.js"></script>
<script>
    $(function () {

        // instantiate recliner
        $('.lazy').recliner({
            attrib: "data-src", // selector for attribute containing the media src
            throttle: 300,      // millisecond interval at which to process events
            threshold: 100,     // scroll distance from element before its loaded
            live: true          // auto bind lazy loading to ajax loaded elements
        });



        // handle lazyshow events
        $(document).on('lazyshow', '.lazy', function () {
            var $e = $(this);
            // do something with the loaded element...
            // console.log('lazyshow', $e);
        });


        /*Update specific hotel name*/
        $("#seo-page-offer-section .image-text-block-style1").each(function () {
            var _heading = $(this).find(".offerName").html();
            var _hotelName = $(this).find(".hotel-name-shimla").html();
            if (_heading.toLowerCase().indexOf("himalayan vacations") != -1) {
                $(this).find(".hotel-name-shimla").html(_hotelName + "<br> The Oberoi Cecil, Shimla");
                $(this).find("a").attr("href", "/special-offers/himalayan-vacations/");
            }
        });

    });



</script>

